{
  "expo": {
    "name": "Rillwood",
    "slug": "rillwood",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rillwood",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "app.rillwood.client",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSLocalNetworkUsageDescription": "Rillwood connects to your Jellyfin server on your local network.",
        "NSCameraUsageDescription": "Rillwood doesn't use the camera. The video player library includes capture code it never runs.",
        "NSMicrophoneUsageDescription": "Rillwood doesn't use the microphone. The video player library includes capture code it never runs.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ]
      }
    },
    "android": {
      "package": "app.rillwood.client",
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      ["expo-screen-orientation", { "initialOrientation": "PORTRAIT_UP" }],
      "expo-sqlite",
      ["expo-secure-store", { "faceIDPermission": false }],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/NotoSans-Regular.ttf",
              "./assets/fonts/NotoSerif-Regular.ttf",
              "./assets/fonts/NotoSansMono-Regular.ttf",
              "./assets/fonts/NotoSansArabic-Regular.ttf",
              "./assets/fonts/NotoSansHebrew-Regular.ttf",
              "./assets/fonts/NotoSansCJKsc-Regular.otf"
            ]
          }
        }
      ],
      "expo-image",
      "expo-status-bar",
      "./modules/mpv/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "sourceUrl": "https://github.com/Dooffy/rillwood",
      "privacyUrl": "https://dooffy.github.io/rillwood/privacy",
      "supportUrl": "https://u24.gov.ua"
    }
  }
}
