{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    },
    "production_tv": {
      "extends": "production",
      "env": {
        "EXPO_TV": "1",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    }
  }
}
