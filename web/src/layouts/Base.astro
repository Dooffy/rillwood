---
// SPDX-License-Identifier: GPL-3.0-or-later
// Every page: head, banner, header with the mark + nav + theme toggle, footer links. Fonts are the system's (no font requests to anyone).
// Dark by default; the toggle picks light and remembers it in localStorage (the site's only script).
import { href, repoUrl } from '../site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const pageTitle = title === 'Rillwood' ? title : `${title} - Rillwood`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch {}
    </script>
  </head>
  <body>
    <p class="banner">
      <span class="banner-dot"></span>Free and open source - for Jellyfin
    </p>
    <header class="site-header wrap">
      <a class="brand" href={href()}>
        <img class="mark-dark" src={href('logo-mark-dark.svg')} alt="" width="32" height="32" />
        <img class="mark-light" src={href('logo-mark-light.svg')} alt="" width="32" height="32" />
        Rillwood
      </a>
      <nav aria-label="Main">
        <a href={`${href()}#features`}>Features</a>
        <a href={`${href()}#privacy`}>Privacy</a>
        {
          repoUrl && (
            <a class="icon-button" href={repoUrl} aria-label="Source code on GitHub" title="Source code on GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .5a11.5 11.5 0 00-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 015.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0012 .5z" />
              </svg>
            </a>
          )
        }
        <button class="icon-button theme-toggle" type="button" aria-label="Light mode" title="Light mode" hidden>
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z" />
          </svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span class="brand-name">Rillwood</span>
        <nav aria-label="Footer">
          <a href={href('privacy')}>Privacy policy</a>
          {repoUrl && <a href={repoUrl}>Source code</a>}
          {repoUrl && <a href={`${repoUrl}/issues`}>Contact</a>}
          {repoUrl && <a href={`${repoUrl}/blob/main/TRADEMARKS.md`}>Trademarks</a>}
        </nav>
        <p>
          © {year} Rillwood. Free software under the GNU GPL version 3 or later. Not affiliated with the Jellyfin project.
        </p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.querySelector('.theme-toggle');
        const label = () => {
          const name = root.dataset.theme === 'light' ? 'Dark mode' : 'Light mode';
          button.setAttribute('aria-label', name);
          button.title = name;
        };
        button.hidden = false;
        label();
        button.addEventListener('click', () => {
          const light = root.dataset.theme !== 'light';
          if (light) root.dataset.theme = 'light';
          else delete root.dataset.theme;
          try {
            if (light) localStorage.setItem('theme', 'light');
            else localStorage.removeItem('theme');
          } catch {}
          label();
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --background: #0c1311;
    --surface: #121b18;
    --surface-raised: #1a2622;
    --border: #1f2c27;
    --text: #e6eeea;
    --text-secondary: #a9bbb3;
    --text-muted: #8a9d95;
    --accent: #7fd1b9;
    --on-accent: #0c1311;
    --link: #7fd1b9;
    --link-hover: #b4e8d8;
    --display: ui-rounded, 'SF Pro Rounded', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  :root[data-theme='light'] {
    color-scheme: light;
    --background: #f6faf8;
    --surface: #ffffff;
    --surface-raised: #e8f0ec;
    --border: #d3e0da;
    --text: #0c1311;
    --text-secondary: #46574f;
    --text-muted: #56675f;
    --accent: #1f7a62;
    --on-accent: #ffffff;
    --link: #1f7a62;
    --link-hover: #12503f;
  }
  * {
    box-sizing: border-box;
  }
  /* Decorations (hero rings, phone shadow) may reach past the column: clip them at the screen edge only (clip, not hidden, so nothing scrolls). */
  main {
    overflow-x: clip;
  }
  body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font:
      16px/1.55 -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
  }
  a {
    color: var(--link);
  }
  a:hover {
    color: var(--link-hover);
  }
  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 700;
  }
  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .site-header {
    padding-top: 24px;
    padding-bottom: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    font-size: 15px;
  }
  .site-header nav a,
  .site-footer nav a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .site-header nav a:hover,
  .site-footer nav a:hover {
    color: var(--text);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
  }
  /* Block, not inline: an inline image sits on the text baseline, above the centre line. */
  .brand img {
    display: block;
  }
  .brand .mark-light,
  [data-theme='light'] .brand .mark-dark {
    display: none;
  }
  [data-theme='light'] .brand .mark-light {
    display: block;
  }
  .banner {
    margin: 0;
    padding: 10px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--display);
    font-size: 16px;
    font-weight: 700;
    text-align: center;
  }
  .banner-dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: currentColor;
  }
  .icon-button {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    cursor: pointer;
  }
  .icon-button:hover {
    color: var(--text);
  }
  .icon-button[hidden] {
    display: none;
  }
  .icon-button svg {
    width: 20px;
    height: 20px;
  }
  .site-header a.icon-button svg {
    fill: currentColor;
  }
  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .theme-toggle .moon,
  [data-theme='light'] .theme-toggle .sun {
    display: none;
  }
  [data-theme='light'] .theme-toggle .moon {
    display: block;
  }
  .site-footer {
    border-top: 1px solid var(--border);
    font-size: 14px;
    color: var(--text-muted);
  }
  .site-footer .wrap {
    padding-top: 32px;
    padding-bottom: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .site-footer p {
    margin: 0;
  }
  .brand-name {
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
    color: var(--text);
  }
  /* Text pages (privacy policy): one readable column. */
  .prose {
    max-width: 680px;
    margin: 0 auto;
    padding: 24px 24px 64px;
    font-size: 17px;
  }
  .prose h1 {
    font-size: clamp(34px, 5vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 24px 0 8px;
  }
  .prose h2 {
    font-size: 21px;
    margin: 32px 0 8px;
  }
  .secondary {
    color: var(--text-secondary);
  }
</style>
