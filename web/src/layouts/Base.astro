---
// SPDX-License-Identifier: GPL-3.0-or-later
// Every page: head, header with the mark, footer links. Colours follow the app's tokens (CLAUDE.md §3).
import { href, repoUrl } from '../site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const pageTitle = title === 'Rillwood' ? title : `${title} - Rillwood`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <header>
      <a class="brand" href={href()}>
        <picture>
          <source srcset={href('logo-mark-dark.svg')} media="(prefers-color-scheme: dark)" />
          <img src={href('logo-mark-light.svg')} alt="" width="32" height="32" />
        </picture>
        Rillwood
      </a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <nav>
        <a href={href('privacy')}>Privacy</a>
        {repoUrl && <a href={repoUrl}>Source code</a>}
        {repoUrl && <a href={`${repoUrl}/issues`}>Support</a>}
        {repoUrl && <a href={`${repoUrl}/blob/main/CONTRIBUTING.md`}>Contributing</a>}
        {repoUrl && <a href={`${repoUrl}/blob/main/TRADEMARKS.md`}>Trademarks</a>}
      </nav>
      <p>
        Free software under the GNU GPL version 3 or later. Rillwood is an independent app for Jellyfin servers, not
        made by or affiliated with the Jellyfin project.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --background: #ffffff;
    --surface: #f2f2f7;
    --separator: #c6c6c8;
    --text: #000000;
    --text-secondary: #6c6c70;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --background: #000000;
      --surface: #1c1c1e;
      --separator: #38383a;
      --text: #ffffff;
      --text-secondary: #98989f;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font: 17px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  header,
  main,
  footer {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 16px;
  }
  header {
    padding-top: 24px;
  }
  main {
    padding-bottom: 48px;
  }
  footer {
    border-top: 1px solid var(--separator);
    padding-top: 24px;
    padding-bottom: 48px;
    color: var(--text-secondary);
    font-size: 15px;
  }
  footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  a {
    color: inherit;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    text-decoration: none;
  }
  /* Block, not inline: an inline image sits on the text baseline, above the centre line. */
  .brand picture,
  .brand img {
    display: block;
  }
  h1 {
    font-size: 34px;
    line-height: 1.2;
    margin: 48px 0 16px;
  }
  h2 {
    font-size: 20px;
    margin: 32px 0 8px;
  }
  .secondary {
    color: var(--text-secondary);
  }
</style>
